# Maintainer: Ximi <ximiyadka124@proton.me>
pkgname=firmware-xiaomi-garnet
pkgver=1
pkgrel=1
pkgdesc="Firmware and WPSS launcher for Xiaomi Redmi Note 13 Pro 5G"
url="https://github.com/garnet-linux"
arch="aarch64"
license="proprietary"
depends="linux-firmware-ath10k tqftpserv"
options="!check !strip !tracedepth !archcheck !spdx"
subpackages="$pkgname-openrc $pkgname-systemd"
source="
	wpss.mdt
	wpss.b00
	wpss.b01
	wpss.b02
	wpss.b03
	wpss.b04
	wpss.b05
	wpss.b06
	wpss.b07
	wpss.b08
	wpss.b10
	firmware-5.bin
	board-2.bin
	wlanmdsp.mbn
	garnet-wpss-start
	garnet-wpss.initd
	garnet-wpss.service
"

build() {
	return 0
}

package() {
	local wpss="$pkgdir"/lib/firmware/qcom/sm7435/garnet
	local ath="$pkgdir"/lib/firmware/ath10k/WCN3990/hw1.0

	install -Dm644 -t "$wpss" "$srcdir"/wpss.mdt "$srcdir"/wpss.b*
	install -Dm644 "$srcdir"/wlanmdsp.mbn "$wpss"/wlanmdsp.mbn
	install -Dm644 "$srcdir"/wlanmdsp.mbn "$pkgdir"/lib/firmware/wlanmdsp.mbn
	install -Dm644 -t "$ath" "$srcdir"/firmware-5.bin "$srcdir"/board-2.bin
	install -Dm755 "$srcdir"/garnet-wpss-start "$pkgdir"/usr/bin/garnet-wpss-start
}

openrc() {
	pkgdesc="$pkgdesc (OpenRC init script)"
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	depends="tqftpserv-openrc"

	install -Dm755 "$srcdir"/garnet-wpss.initd "$subpkgdir"/etc/init.d/garnet-wpss
	mkdir -p "$subpkgdir"/etc/runlevels/default
	ln -s /etc/init.d/garnet-wpss "$subpkgdir"/etc/runlevels/default/garnet-wpss
}

systemd() {
	pkgdesc="$pkgdesc (systemd unit)"
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	depends="tqftpserv-systemd"

	install -Dm644 "$srcdir"/garnet-wpss.service \
		"$subpkgdir"/usr/lib/systemd/system/garnet-wpss.service
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../garnet-wpss.service \
		"$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants/garnet-wpss.service
}

